# Project Wrock-Eye Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
SCENE_UPDATE_RATE_HZ=30

# Cognitive & LLM Provider Configuration ("mock", "openai", "gemini", "ollama")
LLM_PROVIDER=mock

# OpenAI API Key (optional - if using LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini API Key (optional - if using LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Ollama Local LLM Configuration (optional - if using LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Sensory & Voice Settings (Wake Word)
WAKE_WORD=wrock
PINCH_THRESHOLD=0.04
